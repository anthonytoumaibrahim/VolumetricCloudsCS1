<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Cities: Skylines runs Unity 5.6 on Mono's .NET 3.5 profile. -->
    <TargetFramework>net35</TargetFramework>
    <!-- 7.3 is the newest version that needs no polyfill types on net35. -->
    <LangVersion>7.3</LangVersion>
    <RootNamespace>VolumetricClouds</RootNamespace>
    <AssemblyName>VolumetricClouds</AssemblyName>

    <!-- We write Properties\AssemblyInfo.cs by hand instead of letting the SDK generate it. -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- AssemblyVersion(Mod.Version + ".*") is silently ignored while deterministic builds are on. -->
    <Deterministic>false</Deterministic>

    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DebugType>full</DebugType>

    <GameManaged>$(MSBuildProgramFiles32)\Steam\steamapps\common\Cities_Skylines\Cities_Data\Managed</GameManaged>
    <ModsDir>$(LOCALAPPDATA)\Colossal Order\Cities_Skylines\Addons\Mods\$(AssemblyName)</ModsDir>
    <LibsDir>$(MSBuildProjectDirectory)\..\libs</LibsDir>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\CloudIcon.png" />
    <!-- Every language file, as "Localization.<code>.xml": Localization.cs finds them by name. -->
    <EmbeddedResource Include="Localization\*.xml" LogicalName="Localization.%(Filename)%(Extension)" />
    <!-- Shader bundle from UnityProject (see build-bundle.ps1). Conditional so the mod still
         builds without it; it then falls back to billboard clouds at runtime. -->
    <EmbeddedResource Include="Resources\volumetricclouds.bundle"
                      Condition="Exists('Resources\volumetricclouds.bundle')" />
  </ItemGroup>

  <ItemGroup>
    <!-- Build-time only: net35 reference assemblies, which VS no longer installs. -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net35" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <!-- Private=false keeps the game's own DLLs out of bin\ and out of the Mods folder. -->
  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(GameManaged)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="ColossalManaged">
      <HintPath>$(GameManaged)\ColossalManaged.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="ICities">
      <HintPath>$(GameManaged)\ICities.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(GameManaged)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(GameManaged)\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Shipped alongside our DLL; the real Harmony comes from the CitiesHarmony mod. -->
    <Reference Include="CitiesHarmony.API">
      <HintPath>$(LibsDir)\CitiesHarmony.API.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Compile-time only: provided at runtime by the CitiesHarmony mod, never shipped. -->
    <Reference Include="CitiesHarmony.Harmony">
      <HintPath>$(LibsDir)\CitiesHarmony.Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Shipped next to our DLL, the same way MoveIt and TM:PE bundle it. -->
    <Reference Include="UnifiedUILib">
      <HintPath>$(LibsDir)\UnifiedUILib.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="DeployToGame" AfterTargets="Build">
    <MakeDir Directories="$(ModsDir)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ModsDir)" />
    <!-- The PDB is deliberately NOT deployed. Unity 5.6's Mono reads .mdb, not .pdb, so it
         gives the game nothing (no line numbers in any stack trace), while the Workshop
         uploads whatever sits in this folder, along with the source paths inside it. -->
    <Copy SourceFiles="$(LibsDir)\UnifiedUILib.dll" DestinationFolder="$(ModsDir)" />
    <Copy SourceFiles="$(LibsDir)\CitiesHarmony.API.dll" DestinationFolder="$(ModsDir)" />
    <Message Importance="high" Text="Deployed $(AssemblyName).dll -> $(ModsDir)" />
  </Target>

</Project>
